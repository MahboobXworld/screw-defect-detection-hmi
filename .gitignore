# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
.env

# PyTorch / Machine Learning weights
*.pt
*.pth
*.onnx

# Allow tracking only the default model weights
!models/best.onnx

# Database files
*.db
*.sqlite
*.sqlite3

# OS and IDE files
.DS_Store
.vscode/
.idea/

# Project-specific runtime generated files (ignore contents but keep folders)
reports/*.csv
reports/*.pdf
reports/*.xlsx
snapshots/*.jpg

# Ignore conveyor videos except for the sample VID_2.mp4
videos/*.mp4
!videos/VID_2.mp4
videos/*.avi

# Developer scratch files
scratch/

# Large local datasets
train_dataset/
